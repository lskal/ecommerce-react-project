{
  "name": "ecommerce-react-project",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "deploy": "npm run build && cp build/client/index.html build/client/404.html || copy build\\client\\index.html build\\client\\404.html && gh-pages -d build/client",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "clean": "rm -rf node_modules build dist .vite .cache",
    "reinstall": "rm -rf node_modules build dist .vite .cache && npm install",
    "fresh": "rm -rf node_modules build dist .vite .cache && npm install && npm run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "prettier --check . && npm run typecheck"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.9",
    "@react-router/node": "7.12.0",
    "@react-router/serve": "7.12.0",
    "@rjsf/core": "^6.4.1",
    "@rjsf/mui": "^6.4.1",
    "@rjsf/utils": "^6.4.1",
    "@rjsf/validator-ajv8": "^6.4.1",
    "isbot": "^5.1.31",
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-loading-skeleton": "^3.5.0",
    "react-router": "7.12.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@iconify/react": "^6.0.2",
    "@react-router/dev": "7.12.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "gh-pages": "^6.3.0",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  }
}
